#!/bin/sh

if [ "$1" = "-scan" ]; then
  if [ -z "$2" ]; then
    echo "|--------------------------------|"
    echo "|                                |"
    echo "| -scan [wlan0/re0] [jail_name]  |"
    echo "|                                |"
    echo "|_______________or_______________|"
    echo "|                                |" 
    echo "| -scan [wlan0/re0]              |"
    echo "|                                |"
    echo "|________________________________|"
  fi
  if [ -n  "$2" ] && [ -z "$3" ]; then
     wifi="$2"
     IGNORE_NETS="
     142.250.0.0/15
     142.251.0.0/16
     172.217.0.0/16
     192.178.0.0/15
     216.58.192.0/19
     172.64.0.0/13
     104.16.0.0/12
     151.101.0.0/16
     212.73.87.0/24
     178.160.192.0/18
     34.107.0.0/16
     107.178.0.0/15
     "

     IGNORE_IPS=$(sudo sockstat -46c | awk 'NR>1 {print $7}' | rev | cut -d: -f2- | rev | grep -v '^\*$' | sort -u)

     BPF_FILTER=""

     for NET in $IGNORE_NETS; do
        if [ -z "$BPF_FILTER" ]; then
            BPF_FILTER="not net $NET"
        else
            BPF_FILTER="$BPF_FILTER and not net $NET"
        fi
     done

     for IP in $IGNORE_IPS; do
        if [ -z "$BPF_FILTER" ]; then
           BPF_FILTER="not host $IP"
        else
           BPF_FILTER="$BPF_FILTER and not host $IP"
        fi
    done

    if [ -n "$BPF_FILTER" ]; then
       BPF_FILTER="$BPF_FILTER and not arp and not ether proto 0x893a and not port 53 and not ip6 and not ether proto 0x88cc and not net 224.0.0.0/4 and not net 239.0.0.0/8 and not igmp and not port 80 and not port 443"
    else
       BPF_FILTER="not arp and not ether proto 0x893a and not port 53 and not ip6 and not ether proto 0x88cc and not net 224.0.0.0/4 and not net 239.0.0.0/8 and not igmp and not port 80 and not port 443"
    fi
    echo "[*] network filter [*] $wifi "
    sudo tcpdump -ni $wifi $BPF_FILTER
  elif [ -n "$3" ]; then 
    wifi="$2"
    jail="$3"
   IGNORE_NETS="
   142.250.0.0/15
   142.251.0.0/16
   172.217.0.0/16
   192.178.0.0/15
   216.58.192.0/19
   172.64.0.0/13
   104.16.0.0/12
   151.101.0.0/16
   212.73.87.0/24
   178.160.192.0/18
   34.107.0.0/16
   "

   IGNORE_IPS=$(sudo sockstat -46c | awk 'NR>1 {print $7}' | rev | cut -d: -f2- | rev | grep -v '^\*$' | sort -u)

   BPF_FILTER=""

   for NET in $IGNORE_NETS; do
     if [ -z "$BPF_FILTER" ]; then
        BPF_FILTER="not net $NET"
     else
        BPF_FILTER="$BPF_FILTER and not net $NET"
     fi
   done

   for IP in $IGNORE_IPS; do
    if [ -z "$BPF_FILTER" ]; then
        BPF_FILTER="not host $IP"
    else
        BPF_FILTER="$BPF_FILTER and not host $IP"
    fi
   done
   if [ -n "$BPF_FILTER" ]; then
    BPF_FILTER="$BPF_FILTER and not arp and not ether proto 0x893a and not port 53 and not ip6 and not ether proto 0x88cc and not net 224.0.0.0/4 and not net 239.0.0.0/8 and not igmp and not port 80 and not port 443"
   else
    BPF_FILTER="not arp and not ether proto 0x893a and not port 53 and not ip6 and not ether proto 0x88cc and not net 224.0.0.0/4 and not net 239.0.0.0/8 and not igmp and not port 80 and not port 443"
   fi
   echo "[*] network filter [$2] jail -> $3 "
   sudo jexec $jail tcpdump -ni $wifi $BPF_FILTER
  fi 
else 
FETCH_DEST="/tmp/base.txz"
CONF_FILE="/etc/jail.conf"
GATEWAY_IP="10.0.0.2"

# Self-installation to /usr/local/bin
echo "Installing jailsec to /usr/local/bin..."
sudo install -m 755 "$0" /usr/local/bin/jailsec

printf "Enter the full path for the jail (e.g., /tmp/jails/j1_pf): "
read JAIL_PATH
[ -z "$JAIL_PATH" ] && exit 1
JAIL_NAME=$(basename "$JAIL_PATH")

echo "-----------------------------------"
echo "Select your Internet Interface (e.g. re0 or wlan0):"
i=1
INTERFACES=$(ifconfig -l)
for iface in $INTERFACES; do
    echo "$i. $iface"
    eval "iface_$i=$iface"
    i=$((i + 1))
done
printf "Select number: "
read IFACE_NUM
EXT_IF=$(eval echo \$iface_$IFACE_NUM)
echo "$EXT_IF"
JAIL_IP="10.0.0.1"

mkdir -p "$JAIL_PATH"

if [ ! -s "$FETCH_DEST" ]; then
    VERSION=$(freebsd-version | cut -d'-' -f1,2)
    ARCH=$(uname -m)
    echo "Downloading FreeBSD $VERSION base..."
    fetch -o "$FETCH_DEST" "https://download.freebsd.org/ftp/releases/$ARCH/$VERSION/base.txz"
fi

echo "Extracting system to $JAIL_PATH..."
tar -xf "$FETCH_DEST" -C "$JAIL_PATH"

echo "Configuring Network Interfaces..."

# Explicitly create interfaces first
sudo ifconfig bridge0 create >/dev/null 2>&1
sudo ifconfig epair0 create >/dev/null 2>&1

sudo ifconfig bridge0 up
sudo ifconfig epair0b inet $GATEWAY_IP netmask 255.255.255.0 up
sudo ifconfig bridge0 addm epair0b addm epair0a up

sudo sysrc cloned_interfaces+="bridge0 epair0"
sudo sysrc ifconfig_bridge0="addm epair0a inet $GATEWAY_IP/24 up"
sudo sysrc ifconfig_epair0b="up"
sudo sysrc ifconfig_epair0a="up"

echo "Updating $CONF_FILE..."
cat <<EOF | sudo tee -a $CONF_FILE

$JAIL_NAME {
    host.hostname = "$JAIL_NAME";
    path = "$JAIL_PATH";
    vnet;
    vnet.interface = "epair0b", "$EXT_IF";
    mount.devfs;
    devfs_ruleset = "0";
    exec.start = "/bin/sh /etc/rc";
    exec.stop = "/bin/sh /etc/rc.shutdown";
    exec.clean;
    allow.raw_sockets;
}
EOF

echo "Setting up networking inside $JAIL_NAME/etc/rc.conf..."
JAIL_RC="$JAIL_PATH/etc/rc.conf"
sudo touch "$JAIL_RC"

sudo sysrc -f "$JAIL_RC" ifconfig_epair0b="inet $JAIL_IP netmask 255.255.255.0"
sudo sysrc -f "$JAIL_RC" defaultrouter="$GATEWAY_IP"
sudo sysrc -f "$JAIL_RC" jail_enable="YES"

echo "Configuring PF firewall inside $JAIL_NAME..."
JAIL_PF="$JAIL_PATH/etc/pf.conf"

cat <<EOF | sudo tee "$JAIL_PF"
ext_if = "$EXT_IF"
int_if = "epair0b"
j_all  = "10.0.0.0/8"

set skip on lo0
set block-policy drop
set optimization aggressive

nat on \$ext_if from \$j_all to any -> (\$ext_if)

block in on \$ext_if all
pass out quick on \$ext_if proto { tcp, udp, icmp } from any to any keep state
pass in quick on \$int_if from \$j_all to any keep state
EOF

sudo sysrc -f "$JAIL_RC" pf_enable="YES"
sudo sysrc -f "$JAIL_RC" pf_rules="/etc/pf.conf"
sudo sysrc -f "$JAIL_RC" gateway_enable="YES"

echo "PF configuration installed and enabled in jail."

echo "------------------------------------------------"
echo "INSTALLATION COMPLETE"
echo "Jail Name:  $JAIL_NAME"
echo "Jail IP:    $JAIL_IP"
echo "Gateway:    $GATEWAY_IP (on bridge0)"
echo "------------------------------------------------"
echo "To start the jail: service jail start $JAIL_NAME"
echo "To try DHCP later inside jail: jexec $JAIL_NAME dhclient epair0b"
echo ""
echo "You can now run 'jailsec' from anywhere."
echo "To scan the network, use: jailsec -scan"
echo ""
fi
